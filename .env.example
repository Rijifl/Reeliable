# --- Vision model (any OpenAI-compatible /chat/completions endpoint) ---
# Default: Google Gemini Flash free tier — get a key at https://aistudio.google.com/apikey
VLM_API_KEY=                                                   # Required for hosted providers
VLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
VLM_MODEL=gemini-2.5-flash
#
# Swap providers by changing the three vars above, e.g.:
#   OpenRouter:    VLM_BASE_URL=https://openrouter.ai/api/v1     VLM_MODEL=qwen/qwen-2.5-vl-72b-instruct:free
#   Groq:          VLM_BASE_URL=https://api.groq.com/openai/v1   VLM_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct
#   Local/Ollama:  VLM_BASE_URL=http://localhost:11434/v1        VLM_MODEL=qwen2.5vl   VLM_API_KEY=ollama

# --- Claim grounding (optional) — fact-check claims against the web ---
# Uses Gemini's Google Search grounding. Reuses VLM_API_KEY automatically when the
# VLM is Gemini (the default), so it works out of the box. Set explicitly to enable
# grounding alongside a non-Gemini VLM, or leave blank to disable.
GROUNDING_API_KEY=
GROUNDING_MODEL=gemini-2.5-flash

GROQ_API_KEY=        # Optional — audio transcription via Groq Whisper (omit to skip audio)

# Optional — only if reels require a logged-in session to download:
# YTDLP_COOKIES_FILE=/path/to/cookies.txt              # Netscape-format cookie file (best for servers)
# YTDLP_COOKIES_FROM_BROWSER=chrome                    # Reads a local browser profile (local dev only)

PORT=3001
